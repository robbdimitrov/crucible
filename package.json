{
	"name": "crucible",
	"private": true,
	"version": "0.0.1",
	"description": "An opinionated idea crucible — stress-test raw business ideas like a hostile investment committee: generate, validate (pursue/reshape/kill), and spec.",
	"license": "MIT",
	"author": "Robert Dimitrov",
	"keywords": [
		"ideas",
		"startup",
		"validation",
		"vc",
		"ai",
		"gemini",
		"sveltekit"
	],
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-eslint-parser": "^1.8.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@google/genai": "^2.8.0",
		"@lucide/svelte": "^1.17.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"daisyui": "^5.5.23",
		"dompurify": "^3.4.8",
		"marked": "^18.0.5",
		"tailwindcss": "^4.3.0"
	}
}
